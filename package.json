{
  "name": "lumar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "assets": "node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/build-worker.mjs",
    "prebuild": "node scripts/build-worker.mjs",
    "pretest": "node scripts/build-worker.mjs",
    "test:e2e": "playwright test",
    "push:test": "node scripts/build-worker.mjs && vite build --mode push-test --outDir dist-push-test && node scripts/build-sw.mjs --push-test && node scripts/serve-push-test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "web-push": "^4.0.0"
  }
